{
  "name": "corki-desktop",
  "productName": "Corki",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop host for Corki Agent",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.1",
    "highlight.js": "11.11.1",
    "marked": "16.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "electron": "44.8.0",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "png-to-ico": "3.0.2",
    "pngjs": "7.0.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
